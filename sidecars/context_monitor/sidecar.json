{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "AGY Context",
  "description": "Live monitor for current conversation context occupancy, full interaction trace, and project/global token analytics.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "AGY Context",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Context"
      },
      {
        "path": "/trace",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Trace"
      }
    ]
  }
}
